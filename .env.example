# ============================================================
# LRIMS DATABASE CONFIGURATION (PLUGGABLE ADAPTER)
# ============================================================
# Pilihan Koneksi Database:
# 1) Neon DB (Serverless PostgreSQL):
#    DATABASE_URL="postgresql://neondb_owner:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
# 2) Supabase (Cloud PostgreSQL):
#    DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"
#
# 3) Insforge Dev / Generic PostgreSQL:
#    DATABASE_URL="postgresql://postgres:password@localhost:5432/lrims_db"
#
# 4) Kosongkan DATABASE_URL untuk menggunakan Penyimpanan Lokal JSON (File ./data/*.json).
# ============================================================

DATABASE_URL=""
DB_PROVIDER="auto"
